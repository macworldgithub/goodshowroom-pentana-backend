PORT=4000
WEB_ORIGIN=http://localhost:3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
# Alternatively use SUPABASE_PUBLISHABLE_KEY and SUPABASE_SECRET_KEY.
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DATABASE=good_showroom
INITIAL_SETUP_KEY=replace-with-a-long-one-time-secret
AUTH_INVITE_REDIRECT_URL=http://localhost:3000/auth/callback
# Integration is disabled until explicitly configured.
INTEGRATION_MODE=disabled
# Development simulation: mode=simulated, allow=true. Never permitted with NODE_ENV=production.
ALLOW_SIMULATED_INTEGRATION=false
# In scraping mode this permits QUEUING writes for the external runner.
INTEGRATION_WRITES_ENABLED=false
# Simulation processing / scraping expired-lease recovery; disable for deterministic tests.
INTEGRATION_WORKER_ENABLED=true
